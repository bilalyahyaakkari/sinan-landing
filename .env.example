# Copy to .env.local. Never commit .env.local.
# NEXT_PUBLIC_* is exposed to the browser — never put a secret here.

# The API — the packages list, the doctor-join form and the legal texts come from it.
# `next build` fails unless this is an https address (README: "Building for production").
NEXT_PUBLIC_API_URL="http://localhost:3300"

# Where this site is served from — used for link previews and the sitemap.
NEXT_PUBLIC_SITE_URL="https://sinansmile.com"
